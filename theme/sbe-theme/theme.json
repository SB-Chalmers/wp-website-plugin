{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"layout": {
			"contentSize": "100%",
			"wideSize": "100%"
		},
		"typography": {
			"fontSizes": [
				{
					"fluid": false,
					"name": "Small",
					"size": "0.875rem",
					"slug": "small"
				},
				{
					"fluid": {
						"max": "1.125rem",
						"min": "1rem"
					},
					"name": "Medium",
					"size": "1rem",
					"slug": "medium"
				},
				{
					"fluid": {
						"max": "1.375rem",
						"min": "1.125rem"
					},
					"name": "Large",
					"size": "1.38rem",
					"slug": "large"
				},
				{
					"fluid": {
						"min": "1.5rem",
						"max": "1.75rem"
					},
					"name": "Extra Large",
					"size": "1.5rem",
					"slug": "x-large"
				},
				{
					"fluid": {
						"min": "1.9rem",
						"max": "2.5rem"
					},
					"name": "Extra Extra Large",
					"size": "1.9rem",
					"slug": "xx-large"
				}
			]
		}
	},
	"styles": {
		"typography": {
			"fontSize": "var(--wp--preset--font-size--small)",
			"fontFamily": "var:preset|font-family|manrope",
			"fontStyle": "normal",
			"fontWeight": "300"
		},
		"blocks": {
			"core/post-featured-image": {
				"shadow": "none"
			},
			"core/site-title": {
				"elements": {
					"link": {
						":hover": {
							"typography": {
								"textDecoration": "none"
							}
						}
					}
				}
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "700"
				}
			}
		}
	}
}
